{
  "name": "siemens-create-web",
  "version": "0.1.0-rc.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present --stream build",
    "build:create": "pnpm --filter create-siemens-web build",
    "dev": "pnpm --filter create-siemens-web dev",
    "download:theme": "pnpm --filter ix-theme-downloader download",
    "format": "prettier --config prettier.config.mjs --write .",
    "lint:format": "prettier --config prettier.config.mjs --check .",
    "lint": "eslint .",
    "test": "pnpm -r --if-present --stream test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@siemens/prettier-config": "5.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-n": "18.5.0",
    "execa": "9.6.1",
    "ix-theme-downloader": "workspace:*",
    "prettier": "3.9.10",
    "tsdown": "0.23.7",
    "typescript-eslint": "8.71.1",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "pnpm": ">=12.x.x"
  },
  "volta": {
    "node": "26.13.1"
  }
}
