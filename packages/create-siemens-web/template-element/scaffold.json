{
  "id": "element",
  "name": "Element Angular",
  "layouts": [
    {
      "id": "blank",
      "name": "Blank",
      "description": "A bare-bone project setup without any pages or examples",
      "scaffold": {
        "dependencies": [],
        "angular": {
          "assets": [
            { "glob": "**/*", "input": "src/app/layouts/blank/assets", "output": "assets" }
          ]
        }
      }
    },
    {
      "id": "starter",
      "name": "Starter",
      "description": "A project setup with sample pages to get started quickly",
      "scaffold": {
        "dependencies": [
          "@siemens/charts-ng",
          "@siemens/ngx-datatable",
          "echarts",
          "flag-icons",
          "google-libphonenumber"
        ],
        "angular": {
          "assets": [
            { "glob": "**/*", "input": "src/app/layouts/starter/assets", "output": "assets" }
          ]
        }
      }
    },
    {
      "id": "overview",
      "name": "Overview",
      "description": "A browsable gallery of all available layouts and examples",
      "scaffold": {
        "includeLayouts": ["blank", "starter"],
        "preserveHierarchy": true
      }
    }
  ],
  "scaffold": {
    "routesFile": "src/app/app.routes.ts",
    "dependencies": [
      "@angular/aria",
      "@angular/cdk",
      "@angular/common",
      "@angular/compiler",
      "@angular/core",
      "@angular/forms",
      "@angular/platform-browser",
      "@angular/router",
      "@ngx-translate/core",
      "@ngx-translate/http-loader",
      "@siemens/element-icons",
      "@siemens/element-ng",
      "@siemens/element-theme",
      "@siemens/element-translate-ng",
      "rxjs",
      "tslib"
    ],
    "angular": true
  }
}
